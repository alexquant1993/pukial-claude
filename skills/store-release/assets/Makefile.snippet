
# Store releases through fastlane (settings in fastlane/release.yml; one-time setup: README, Releasing).
# make release-check                                              (read-only: credentials, store build numbers)
# make release-android TRACK=internal
# make release-android TRACK=production ROLLOUT=100 CONFIRM=yes  (ROLLOUT in %, default from release.yml; promotes the internal build)
# make release-rollout PERCENT=50 CONFIRM=yes
# make release-ios                                               (TestFlight)
# CONFIRM only counts when typed on the command line, so an exported CONFIRM in the shell cannot confirm a production run.
# CONFIG=release-dev.yml picks another settings file in fastlane/ (a second app from the same repo); like CONFIRM it only counts
# when typed on the command line (an exported CONFIG or RELEASE_CONFIG never picks the app), and no CONFIG means release.yml.
# SKIP_BUILD=true reuses the last build, e.g. to retry a failed upload.
FASTLANE=LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 FASTLANE_SKIP_UPDATE_CHECK=1 FASTLANE_OPT_OUT_USAGE=YES fastlane

.PHONY: release-check release-android release-rollout release-ios

release-check:
	RELEASE_CONFIG=$(if $(filter command line,$(origin CONFIG)),$(CONFIG)) $(FASTLANE) check

release-android:
	RELEASE_CONFIG=$(if $(filter command line,$(origin CONFIG)),$(CONFIG)) $(FASTLANE) android release track:$(TRACK) $(if $(ROLLOUT),rollout:$(ROLLOUT)) $(if $(filter command line,$(origin CONFIRM)),confirm:$(CONFIRM)) $(if $(SKIP_BUILD),skip_build:$(SKIP_BUILD))

release-rollout:
	RELEASE_CONFIG=$(if $(filter command line,$(origin CONFIG)),$(CONFIG)) $(FASTLANE) android rollout percent:$(PERCENT) $(if $(filter command line,$(origin CONFIRM)),confirm:$(CONFIRM))

release-ios:
	RELEASE_CONFIG=$(if $(filter command line,$(origin CONFIG)),$(CONFIG)) $(FASTLANE) ios release $(if $(SKIP_BUILD),skip_build:$(SKIP_BUILD))
