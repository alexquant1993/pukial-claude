#!/usr/bin/env bash
# Entry point for people and agents: finds a Node >= 22.12, installs dependencies when they are
# missing or stale (plugin updates replace this folder), then runs the CLI.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

node_ok() {
  "$1" -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=12)?0:1)' 2>/dev/null
}

NODE=""
if command -v node >/dev/null 2>&1 && node_ok "$(command -v node)"; then
  NODE="$(command -v node)"
else
  for candidate in $(ls -d "$HOME"/.nvm/versions/node/v*/bin/node 2>/dev/null | sort -V -r) \
                   /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$candidate" ] && node_ok "$candidate"; then NODE="$candidate"; break; fi
  done
fi
if [ -z "$NODE" ]; then
  echo "app-pilot needs Node.js >= 22.12. Install it (e.g. 'nvm install 24') and retry." >&2
  exit 3
fi
export PATH="$(dirname "$NODE"):$PATH"

STAMP="$HERE/node_modules/.app-pilot-lock"
if [ ! -f "$STAMP" ] || ! cmp -s "$HERE/package-lock.json" "$STAMP"; then
  echo "app-pilot: installing runner dependencies (first run or after an update)..." >&2
  (cd "$HERE" && npm ci --no-fund --no-audit --loglevel=error >&2)
  cp "$HERE/package-lock.json" "$STAMP"
fi

exec "$NODE" "$HERE/src/cli.mjs" "$@"
